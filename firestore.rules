rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ganti / tambah email admin di sini
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['diazkurniawanc@gmail.com'];
    }

    match /pengajuan/{id} {
      // Pelanggan hanya boleh MENGIRIM (tidak bisa membaca/mengubah)
      allow create: if request.resource.data.keys().hasOnly(
            ['name','biz','city','phone','note','placement','time','total','count','items','lines','design','preview','status','adminNote','createdAt'])
        && request.resource.data.status == 'baru'
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 200
        && request.resource.data.preview.size() < 600000
        && request.resource.data.design.size() < 30000;

      allow read, update, delete: if isAdmin();
    }
  }
}
